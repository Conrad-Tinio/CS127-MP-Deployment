# Backend Environment Variables
# Copy this file to .env for local development
# In production (Render), set these in the dashboard

# Server Port (Render sets this automatically)
PORT=8080

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=jdbc:postgresql://aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.your-project-ref
DATABASE_PASSWORD=your-supabase-password

# CORS - Allowed Origins (comma-separated)
# For production, set to your Vercel frontend URL
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
SHOW_SQL=true
LOG_LEVEL_SPRING=INFO
LOG_LEVEL_HIBERNATE=DEBUG

# Connection Pool
HIKARI_MAX_POOL_SIZE=5
HIKARI_MIN_IDLE=1

